# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (Cycle 5+)
NEXT_PUBLIC_POSTHOG_KEY=

# Stripe (Cycle 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (Cycle 2+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Cloud Vision — Snap & List (Cycle 58)
# GOOGLE_APPLICATION_CREDENTIALS_JSON must be the full service-account JSON,
# base64-encoded (e.g. `base64 < path/to/key.json | tr -d '\n'`). Do NOT point
# at a filesystem path — Vercel serverless workers can't read local files.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Resend (Cycle 5)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
